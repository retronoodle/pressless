.claude/
.kilo/
.kilocode/
.opencode/
docs/

# Local override for ripgrep/gitignore-aware tools (opencode @-mentions, etc).
# Keeps docs/ referenceable without committing it.
.ignore

# Composer
/vendor/

# Stead dist artefacts (built by `bin/release`). The release ZIP is meant
# to be uploaded, not committed.
/stead-*.zip

# Stray sqlite test artefacts (e.g. left behind by an interrupted
# `bin/migrate --fresh` or a manually created DB). The real DB lives in
# /var/, so anything matching `stead-*.{sqlite,sqlite-shm,sqlite-wal}` or
# `timmah*` is a bug, not part of the project.
/stead-*.sqlite
/stead-*.sqlite-shm
/stead-*.sqlite-wal
/timmah*


# Environment & secrets (see also task 2.5 for .env.example convention)
.env
.env.*
!.env.example

# Installer completion marker. Must never be committed — its presence
# skips the install wizard, which broke fresh deploys before (installed.lock
# was accidentally tracked from the initial commit).
/installed.lock

# Runtime paths (cache, logs, twig cache)
/var/cache/*
/var/log/*
!/var/cache/.gitkeep
!/var/log/.gitkeep

# Uploaded media is project state, not source. The directory itself is kept
# in git so the first upload doesn't have to handle a missing-parent race.
/storage/media/*
!/storage/media/.gitkeep

# Local SQLite databases. These hold real password hashes once seeded, so they
# must never be committed. WAL mode also produces -shm/-wal sidecar files.
/var/*.sqlite
/var/*.sqlite-shm
/var/*.sqlite-wal
/var/*.db

# Local backup archives. These are generated dumps of the DB and media
# directory, made on-demand or before an update — not source, and can contain
# real user data. LocalStorageTarget creates the directory itself if missing.
/var/backups/*

# Test & static analysis caches
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan.cache/

# IDE & OS noise
.DS_Store
.idea/
.vscode/
*.swp
