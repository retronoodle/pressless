{
    "name": "stead/stead",
    "description": "A PHP CMS for people who want to publish a website without plugin soup.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "twig/twig": "^3.10",
        "symfony/http-foundation": "^7.0",
        "symfony/console": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "symfony/yaml": "^7.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Stead\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stead\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@stan"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
