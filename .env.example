# Stead example environment file.
# Copy this file to `.env` and adjust the values for your local install.
# Anything set in the real process environment already takes precedence over this file.

# Application environment: "development" or "production". Tests run as "test".
APP_ENV=development

# Debug toggles verbose error output. Never enable in production.
APP_DEBUG=false

# Database driver: "mysql", "mariadb", or "sqlite".
DB_CONNECTION=mysql

# MySQL/MariaDB connection settings. Ignored when DB_CONNECTION=sqlite.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stead
DB_USERNAME=stead
DB_PASSWORD=changeme

# SQLite database path. Ignored when DB_CONNECTION is mysql/mariadb.
# Relative paths are resolved against the project root.
DB_DATABASE=var/stead.sqlite

# Session name presented to the browser. PHP session security settings are
# configured in config/app.yaml under `sessions`.
SESSION_NAME=stead_session

# Logging
LOGGING_LEVEL=info
LOGGING_FILE=stead.log
