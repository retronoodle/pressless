{% extends 'layout/base.twig' %}

{% block title %}Site settings - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-settings{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'settings'} %}

<main class="admin-main">
    <section class="settings-header">
        <h2>Site settings</h2>
        <p>Site-wide identity used across the public site.</p>
    </section>

    {% if flash %}
        <section class="form-flash">
            <p>{{ flash|e }}</p>
        </section>
    {% endif %}

    {% if errors|length > 0 %}
        <section class="form-errors">
            <h3>Please correct the following:</h3>
            <ul>
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li><strong>{{ field|e }}:</strong> {{ message|e }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <form method="post" action="{{ action_url }}" class="settings-form">
        <label>
            <span>Site name</span>
            <input type="text" name="site_name" value="{{ values.site_name|e }}" maxlength="190">
        </label>
        <label>
            <span>Timezone</span>
            <input type="text" name="timezone" value="{{ values.timezone|e }}" required placeholder="UTC">
        </label>
        <label>
            <span>Date format</span>
            <input type="text" name="date_format" value="{{ values.date_format|e }}" required placeholder="Y-m-d">
            <small>PHP <code>date()</code> format string (e.g. <code>Y-m-d</code>, <code>F j, Y</code>).</small>
        </label>

        <fieldset class="settings-homepage">
            <legend>Homepage</legend>
            <p class="settings-homepage-current">
                Currently serving
                <strong>
                    {% if homepage.effective_type == 'static_page' %}
                        a static page
                    {% elseif homepage.effective_type == 'blog' %}
                        a blog (most-recent-first listing)
                    {% else %}
                        the collection listing
                    {% endif %}
                </strong>
                {% if homepage.effective_source == 'override' %}
                    (admin override)
                {% elseif homepage.effective_source == 'theme' %}
                    (theme default)
                {% else %}
                    (built-in fallback — no theme default declared)
                {% endif %}.
            </p>

            <label class="settings-homepage-action">
                <input type="radio" name="homepage_action" value="use_theme_default"
                       {% if not homepage.has_override %}checked{% endif %}>
                Use theme default
                {% if homepage.theme_default is not null %}
                    ({{ homepage.theme_default == 'static_page' ? 'static page'
                        : (homepage.theme_default == 'blog' ? 'blog' : 'collection listing') }})
                {% else %}
                    (collection listing — no theme default declared)
                {% endif %}
            </label>

            <label class="settings-homepage-action">
                <input type="radio" name="homepage_action" value="static_page"
                       {% if homepage.has_override and values.homepage_type == 'static_page' %}checked{% endif %}>
                Use a static page as the homepage
            </label>

            <label class="settings-homepage-page">
                <span>Page</span>
                <select name="homepage_page_id">
                    <option value="">— Pick a published entry —</option>
                    {% for page in homepage.pages %}
                        <option value="{{ page.id }}"
                                {% if values.homepage_page_id is not empty and values.homepage_page_id == page.id %}selected{% endif %}>
                            {{ page.collection_name|e }} / {{ page.title|e }} ({{ page.slug|e }})
                        </option>
                    {% else %}
                        <option value="" disabled>No published entries yet — create one first.</option>
                    {% endfor %}
                </select>
                {% if errors.homepage_page_id is defined %}
                    <small class="field-error">{{ errors.homepage_page_id[0]|e }}</small>
                {% endif %}
            </label>

            <label class="settings-homepage-action">
                <input type="radio" name="homepage_action" value="blog"
                       {% if homepage.has_override and values.homepage_type == 'blog' %}checked{% endif %}>
                Use a blog as the homepage
            </label>

            <label class="settings-homepage-collection">
                <span>Collection</span>
                <select name="homepage_collection_id">
                    <option value="">— Pick a collection —</option>
                    {% for collection in homepage.collections %}
                        <option value="{{ collection.id() }}"
                                {% if values.homepage_collection_id is not empty and values.homepage_collection_id == collection.id() %}selected{% endif %}>
                            {{ collection.name|e }} ({{ collection.slug|e }})
                        </option>
                    {% else %}
                        <option value="" disabled>No collections yet — create one first.</option>
                    {% endfor %}
                </select>
                {% if errors.homepage_collection_id is defined %}
                    <small class="field-error">{{ errors.homepage_collection_id[0]|e }}</small>
                {% endif %}
            </label>

            {% if errors.homepage_type is defined %}
                <p class="field-error">{{ errors.homepage_type[0]|e }}</p>
            {% endif %}
        </fieldset>

        <p><button type="submit">Save settings</button></p>
    </form>

    <section class="settings-seed-default-collections">
        <h3>Seed default collections</h3>
        <p>
            The <code>posts</code> and <code>pages</code> collections are normally
            created when the installer finishes. Use this if your site skipped
            that step (or was installed before this seeding existed). Existing
            collections are left untouched.
        </p>
        <form method="post" action="{{ seed_url }}">
            <button type="submit">Seed default collections</button>
        </form>
    </section>
</main>
{% endblock %}
