{% extends 'layout/base.twig' %}

{% block title %}Confirm restore - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-backups{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'backups'} %}

<main class="admin-main">
    <section class="backups-restore-confirm">
        <h2>Confirm restore</h2>
        <p>
            This will overwrite the current database and media directory with the contents
            of backup <strong>#{{ backup.id }}</strong>. This cannot be undone.
        </p>
        <dl>
            <dt>Target</dt>
            <dd><code>{{ backup.target }}</code></dd>
            <dt>Created</dt>
            <dd>{{ backup.created_at }}</dd>
            <dt>Size</dt>
            <dd>{{ backup.size_human }}</dd>
        </dl>
        <form method="post" action="{{ restore_url }}">
            <input type="hidden" name="id" value="{{ backup.id }}">
            <input type="hidden" name="confirm" value="{{ backup.id }}">
            <button type="submit" class="button--danger">Yes, restore from backup #{{ backup.id }}</button>
        </form>
        <p><a href="/admin/backups">Cancel</a></p>
    </section>
</main>
{% endblock %}
