{% extends 'layout/base.twig' %}

{% block title %}Confirm restore - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-backups{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            <li><a href="/admin/users">Users</a></li>
            <li><a href="/admin/permissions">Permissions</a></li>
            <li><a href="/admin/mail-settings">Mail</a></li>
            <li><a href="/admin/invites">Invites</a></li>
            <li><a href="/admin/backups" aria-current="page">Backups</a></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong> ({{ user_role }}).</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="backups-restore-confirm">
        <h2>Confirm restore</h2>
        <p>
            This will overwrite the current database and media directory with the contents
            of backup <strong>#{{ backup.id }}</strong>. This cannot be undone.
        </p>
        <dl>
            <dt>Target</dt>
            <dd><code>{{ backup.target }}</code></dd>
            <dt>Created</dt>
            <dd>{{ backup.created_at }}</dd>
            <dt>Size</dt>
            <dd>{{ backup.size_human }}</dd>
        </dl>
        <form method="post" action="{{ restore_url }}">
            <input type="hidden" name="id" value="{{ backup.id }}">
            <input type="hidden" name="confirm" value="{{ backup.id }}">
            <button type="submit">Yes, restore from backup #{{ backup.id }}</button>
        </form>
        <p><a href="/admin/backups">Cancel</a></p>
    </section>
</main>
{% endblock %}
