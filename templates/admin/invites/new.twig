{% extends 'layout/base.twig' %}

{% block title %}Invite a user - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-invites{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            <li><a href="/admin/users">Users</a></li>
            <li><a href="/admin/permissions">Permissions</a></li>
            <li><a href="/admin/mail-settings">Mail</a></li>
            <li><a href="/admin/invites" aria-current="page">Invites</a></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong> ({{ user_role }}).</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="invites-header">
        <h2>Invite a user</h2>
        <p>Send a single-use link to a new user's email. They'll set their own password.</p>
    </section>

    {% if flash %}
        <section class="form-flash">
            <p>{{ flash|e }}</p>
        </section>
    {% endif %}

    {% if errors|length > 0 %}
        <section class="form-errors">
            <h3>Please correct the following:</h3>
            <ul>
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li><strong>{{ field|e }}:</strong> {{ message|e }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <form method="post" action="{{ action_url }}" class="invite-form">
        <label>
            <span>Email</span>
            <input type="email" name="email" value="{{ values.email|e }}" required autofocus>
        </label>
        <label>
            <span>Role</span>
            <select name="role_id" required>
                {% for role in roles %}
                    <option value="{{ role.id }}" {% if values.role_id == role.id %}selected{% endif %}>{{ role.name|e }}</option>
                {% endfor %}
            </select>
        </label>
        <p><button type="submit">Send invite</button></p>
    </form>
</main>
{% endblock %}
