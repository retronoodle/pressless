{% extends 'layout/base.twig' %}

{% block title %}Permissions - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-permissions{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            <li><a href="/admin/users">Users</a></li>
            <li><a href="/admin/permissions" aria-current="page">Permissions</a></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong> ({{ user_role }}).</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="permissions-header">
        <h2>Permissions</h2>
        <p>Grant the <code>editor</code> and <code>author</code> roles access to specific collections and actions. Admins are unrestricted and don't appear here.</p>
    </section>

    <form method="post" action="/admin/permissions" class="permissions-form">
        <table class="permissions-table">
            <thead>
                <tr>
                    <th scope="col">Role</th>
                    <th scope="col">Collection</th>
                    {% for action in actions %}
                        <th scope="col">{{ action }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for role in roles %}
                    {% for collection in collections %}
                        <tr>
                            {% if loop.first %}
                                <td rowspan="{{ collections|length }}">{{ role.name|e }}</td>
                            {% endif %}
                            <td>{{ collection.name|e }} (<code>{{ collection.slug|e }}</code>)</td>
                            {% for action in actions %}
                                <td>
                                    <input type="checkbox"
                                           name="permissions[{{ role.id }}:{{ collection.id }}][{{ action }}]"
                                           {% if role.cells[collection.id][action] %}checked{% endif %}>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
        <p><button type="submit">Save permissions</button></p>
    </form>
</main>
{% endblock %}
