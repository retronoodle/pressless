{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Entries - {{ collection.name|e }} - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-entries{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: ''} %}

<main class="admin-main admin-main--wide">
    <section class="active-collection">
        <p>Now editing <strong>{{ collection.name|e }}</strong> (<code>{{ collection.slug|e }}</code>)</p>
    </section>
    <section class="entries-header">
        <h2>{{ collection.name|e }} entries</h2>
        <p>
            <a href="/admin/collections">All collections</a>
            {% if user_role == 'admin' %}
                &middot;
                <a href="/admin/collections/{{ collection.slug|e }}/edit">Edit collection</a>
            {% endif %}
            {% if can_edit %}
                &middot;
                <a href="/admin/collections/{{ collection.slug|e }}/entries/new" data-shortcut="mod+shift+n">{% include 'admin/_icons/add.twig' %}New entry</a>
            {% endif %}
        </p>
    </section>

    {% if entries is empty %}
        {{ state.empty('No entries yet', 'Add the first entry to start filling this collection.', can_edit ? ('/admin/collections/' ~ collection.slug|e ~ '/entries/new') : null, can_edit ? 'Create entry' : null) }}
    {% else %}
        <table class="admin-table entries-table">
            <thead>
                <tr>
                    <th scope="col">Slug</th>
                    <th scope="col">Status</th>
                    <th scope="col">Preview</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td><code>{{ entry.slug|e }}</code></td>
                        <td><span class="status status-{{ entry.status|e }}">{{ entry.status|e }}</span></td>
                        <td>{{ entry.preview|e }}</td>
                        <td>
                            {% if can_edit and (not ownership_scoped or entry.author_id == user_id) %}
                                <a href="/admin/collections/{{ collection.slug|e }}/entries/{{ entry.id }}/edit">{% include 'admin/_icons/edit.twig' %}Edit</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}

{% block admin_scripts %}
<script defer src="/assets/js/admin/keyboard-shortcuts.js"></script>
{% endblock %}
