{% extends 'layout/base.twig' %}

{% block title %}{{ form_title|e }}{% endblock %}

{% block body_class %}stead stead-admin stead-entries{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: ''} %}

<main class="admin-main">
    <section class="active-collection">
        <p>Now editing <strong>{{ collection.name|e }}</strong> (<code>{{ collection.slug|e }}</code>)
            &middot;
            <a href="/admin/collections/{{ collection.slug|e }}" data-shortcut="mod+shift+l">Back to entries</a>
        </p>
    </section>

    <h2>{{ form_title|e }}</h2>

    {% if is_edit and entry.id() > 0 %}
        <p class="entry-status">
            <strong>Status:</strong>
            <span class="status status-{{ entry.status()|e }}">{{ entry.status()|e }}</span>
            {% if entry.publishedAt() is not null %}
                <small>(published {{ entry.publishedAt()|e }})</small>
            {% endif %}
        </p>
    {% endif %}

    {% if slug_preview %}
        <p class="slug-preview">
            <strong>Slug:</strong>
            <code>{{ slug_preview|e }}</code>
            {% if not is_edit %}<small>(generated from the slug source field)</small>{% endif %}
        </p>
    {% endif %}

    {% if errors.__schema is defined %}
        <ul class="form-errors" role="alert">
            {% for message in errors.__schema %}
                <li>{{ message|e }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <form method="post" action="{{ action_url }}">
        {% for field in fields %}
            {% set field_key = field.key|default('') %}
            {% set field_type = field.type|default('text') %}
            {% if field_types.has(field_type) %}
                {% set type_handler = field_types.get(field_type) %}
                {% set field_value = values[field_key]|default(null) %}
                {% set field_errors = errors[field_key]|default([]) %}
                <fieldset class="field field-{{ field_type|e }}">
                    {{ type_handler.renderForm(field, field_value, field_errors)|raw }}
                </fieldset>
            {% endif %}
        {% endfor %}

        <fieldset class="field field-seo">
            <legend>SEO</legend>
            <p class="hint">Optional metadata for search engines and social shares.</p>
            <label>
                <span>Meta title</span>
                <input type="text" name="seo[meta_title]" value="{{ seo.meta_title|default('')|e }}" maxlength="255">
            </label>
            <label>
                <span>Meta description</span>
                <textarea name="seo[meta_description]" rows="3" maxlength="500">{{ seo.meta_description|default('')|e }}</textarea>
            </label>
            <label>
                <span>Open Graph image</span>
                <select name="seo[og_image_id]">
                    <option value="0" {% if not seo.og_image_id %}selected{% endif %}>— None —</option>
                    {% for item in media_items %}
                        <option value="{{ item.id()|e }}" {% if seo.og_image_id == item.id() %}selected{% endif %}>{{ item.filename()|e }} ({{ item.mimeType()|e }})</option>
                    {% endfor %}
                </select>
                <small>Upload new files in <a href="/admin/media">Media</a>.</small>
            </label>
        </fieldset>

        <p>
            <button type="submit" data-shortcut="mod+s">Save entry</button>
            <a class="button--secondary" href="{{ cancel_url|e }}">Cancel</a>
        </p>
    </form>

    {% if is_edit and entry.id() > 0 %}
        <section class="entry-actions">
            <h3>Lifecycle</h3>
            {% if entry.isPublished() %}
                {% if unpublish_url %}
                    <form method="post" action="{{ unpublish_url }}">
                        <button type="submit" class="button--secondary">Unpublish</button>
                    </form>
                {% endif %}
            {% else %}
                {% if publish_url %}
                    <form method="post" action="{{ publish_url }}">
                        <button type="submit" data-shortcut="mod+enter">Publish</button>
                    </form>
                {% endif %}
            {% endif %}
            {% if delete_url %}
                <form method="post" action="{{ delete_url }}">
                    <button type="submit" class="button--danger">Delete</button>
                </form>
            {% endif %}
            <p>
                <a href="{{ revisions_url }}">View revision history</a>
            </p>
        </section>
    {% endif %}
</main>
{% endblock %}

{% block admin_scripts %}
<script defer src="/assets/js/vendor/tiptap.bundle.js"></script>
<script defer src="/assets/js/admin/richtext-editor.js"></script>
<script defer src="/assets/js/admin/keyboard-shortcuts.js"></script>
{% endblock %}