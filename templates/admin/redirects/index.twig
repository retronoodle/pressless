{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Redirects - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-redirects{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            <li><a href="/admin/users">Users</a></li>
            <li><a href="/admin/permissions">Permissions</a></li>
            <li><a href="/admin/mail-settings">Mail</a></li>
            <li><a href="/admin/settings">Settings</a></li>
            <li><a href="/admin/redirects" aria-current="page">Redirects</a></li>
            <li><a href="/admin/invites">Invites</a></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong> ({{ user_role }}).</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="redirects-header">
        <h2>Redirects</h2>
        <p>Path-to-path redirects served as HTTP 301. Slug changes on entries create redirects automatically; add more by hand here.</p>
    </section>

    {% if flash %}
        <section class="form-flash">
            <p>{{ flash|e }}</p>
        </section>
    {% endif %}

    {% if errors|length > 0 %}
        <section class="form-errors">
            <h3>Please correct the following:</h3>
            <ul>
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li><strong>{{ field|e }}:</strong> {{ message|e }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <form method="post" action="{{ action_url }}" class="redirects-add-form">
        <label>
            <span>Old path</span>
            <input type="text" name="old_path" value="{{ values.old_path|default('')|e }}" placeholder="/posts/old-slug" required>
        </label>
        <label>
            <span>New path</span>
            <input type="text" name="new_path" value="{{ values.new_path|default('')|e }}" placeholder="/posts/new-slug" required>
        </label>
        <p><button type="submit">Add redirect</button></p>
    </form>

    {% if rows|length > 0 %}
        <table class="redirects-table">
            <thead>
                <tr>
                    <th>Old path</th>
                    <th>New path</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td><code>{{ row.old_path|e }}</code></td>
                        <td><code>{{ row.new_path|e }}</code></td>
                        <td>{{ row.created_at|default('')|e }}</td>
                        <td>
                            <form method="post" action="/admin/redirects/{{ row.id|e }}/delete" onsubmit="return confirm('Delete this redirect?');">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        {{ state.empty('No redirects configured yet.', 'Use the form above to add a path-to-path redirect.') }}
    {% endif %}
</main>
{% endblock %}