{# Renders a single field's label, control, current value, and inline error list.

   Required context:
     - field:    array<string, mixed>     the normalized field definition
     - value:    mixed                     the current value (scalar or array)
     - errors:   list<string>              inline error messages for this field
     - type:     Pressless\Content\FieldType\FieldType   the field type handler
#}
{% import _self as forms %}
<fieldset class="field field-{{ field.type|e }}">
    {{ type.renderForm(field, value, errors)|raw }}
</fieldset>
