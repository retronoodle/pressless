{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Users - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-users{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'users'} %}

<main class="admin-main admin-main--wide">
    <section class="users-header">
        <h2>Users</h2>
        <p><a class="button" href="{{ new_user_url }}">{% include 'admin/_icons/add.twig' %}New user</a></p>
    </section>

    {% if users is empty %}
        {{ state.empty('No users yet', 'Invite the first user to get started.', new_user_url, 'Invite user') }}
    {% else %}
        <table class="admin-table users-table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Active</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.name|e }}</td>
                        <td><code>{{ u.email|e }}</code></td>
                        <td>{{ u.role_name|e }}</td>
                        <td>{{ u.is_active ? 'yes' : 'no' }}</td>
                        <td>
                            <a href="/admin/users/{{ u.id }}/role">Change role</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}
