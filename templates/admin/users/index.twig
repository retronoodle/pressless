{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Users - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-users{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            <li><a href="/admin/users" aria-current="page">Users</a></li>
            <li><a href="/admin/permissions">Permissions</a></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong> ({{ user_role }}).</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="users-header">
        <h2>Users</h2>
        <p><a class="button" href="{{ new_user_url }}">New user</a></p>
    </section>

    {% if users is empty %}
        {{ state.empty('No users yet', 'Invite the first user to get started.', new_user_url, 'Invite user') }}
    {% else %}
        <table class="users-table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Active</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.name|e }}</td>
                        <td><code>{{ u.email|e }}</code></td>
                        <td>{{ u.role_name|e }}</td>
                        <td>{{ u.is_active ? 'yes' : 'no' }}</td>
                        <td>
                            <a href="/admin/users/{{ u.id }}/role">Change role</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}
