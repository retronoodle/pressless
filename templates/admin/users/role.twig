{% extends 'layout/base.twig' %}

{% block title %}Change role - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-users{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'users'} %}

<main class="admin-main">
    <section class="users-header">
        <h2>Change role for {{ target.name|e }}</h2>
        <p><code>{{ target.email|e }}</code></p>
        <p><a href="/admin/users">All users</a></p>
    </section>

    {% if errors|length > 0 %}
        <section class="form-errors">
            <ul>
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li><strong>{{ field|e }}:</strong> {{ message|e }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <form method="post" action="{{ action_url }}" class="user-form">
        <label>
            <span>Role</span>
            <select name="role_name">
                {% for role in roles %}
                    <option value="{{ role.name|e }}" {% if target.role_name == role.name %}selected{% endif %}>{{ role.name|e }}</option>
                {% endfor %}
            </select>
        </label>
        <p><button type="submit">Update role</button></p>
    </form>
</main>
{% endblock %}
