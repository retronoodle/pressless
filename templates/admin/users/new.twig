{% extends 'layout/base.twig' %}

{% block title %}New user - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-users{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'users'} %}

<main class="admin-main">
    <section class="users-header">
        <h2>New user</h2>
        <p><a href="/admin/users">All users</a></p>
    </section>

    {% if errors|length > 0 %}
        <section class="form-errors">
            <h3>Please correct the following:</h3>
            <ul>
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li><strong>{{ field|e }}:</strong> {{ message|e }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <form method="post" action="{{ action_url }}" class="user-form">
        <label>
            <span>Name</span>
            <input type="text" name="name" value="{{ values.name|e }}" required>
        </label>
        <label>
            <span>Email</span>
            <input type="email" name="email" value="{{ values.email|e }}" required>
        </label>
        <label>
            <span>Password</span>
            <input type="password" name="password" required minlength="8">
        </label>
        <label>
            <span>Role</span>
            <select name="role_name">
                {% for role in roles %}
                    <option value="{{ role.name|e }}" {% if values.role_name == role.name %}selected{% endif %}>{{ role.name|e }}</option>
                {% endfor %}
            </select>
        </label>
        <p><button type="submit">Create user</button></p>
    </form>
</main>
{% endblock %}
