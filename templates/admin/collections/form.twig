{% extends 'layout/base.twig' %}

{% block title %}{{ form_title|e }}{% endblock %}

{% block body_class %}stead stead-admin stead-collections{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections" aria-current="page">Collections</a></li>
            <li><span class="nav-placeholder" aria-disabled="true">Media</span></li>
            <li><span class="nav-placeholder" aria-disabled="true">Users</span></li>
            <li><span class="nav-placeholder" aria-disabled="true">Settings</span></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong>.</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <h2>{{ form_title|e }}</h2>

    {% if errors.__schema is defined %}
        <ul class="form-errors" role="alert">
            {% for message in errors.__schema %}
                <li>{{ message|e }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <form method="post" action="{{ action_url }}">
        <p>
            <label for="collection-slug">Slug</label>
            <input type="text" id="collection-slug" name="slug" value="{{ form_slug|e }}" required pattern="[a-z0-9_-]+">
        </p>
        <p>
            <label for="collection-name">Name</label>
            <input type="text" id="collection-name" name="name" value="{{ form_name|e }}" required>
        </p>

        <fieldset class="schema-fields">
            <legend>Fields</legend>

            {% for field in fields %}
                {% set field_key = field.key|default('') %}
                {% set field_type = field.type|default('text') %}
                {% set field_label = field.label|default('') %}
                {% set field_required = field.required|default(false) %}
                {% set field_errors = errors[field_key]|default([]) %}

                <fieldset class="schema-field" data-index="{{ loop.index0 }}">
                    <legend>Field {{ loop.index }}</legend>

                    {% if field_errors %}
                        <ul class="field-errors" role="alert">
                            {% for message in field_errors %}
                                <li>{{ message|e }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <p>
                        <label>Key
                            <input type="text" name="fields[{{ loop.index0 }}][key]" value="{{ field_key|e }}" required pattern="^[a-z][a-z0-9_]*$">
                        </label>
                    </p>
                    <p>
                        <label>Label
                            <input type="text" name="fields[{{ loop.index0 }}][label]" value="{{ field_label|e }}">
                        </label>
                    </p>
                    <p>
                        <label>Type
                            <select name="fields[{{ loop.index0 }}][type]">
                                {% for ft in field_types.all() %}
                                    <option value="{{ ft.key() }}" {% if ft.key() == field_type %}selected{% endif %}>{{ ft.label() }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </p>
                    <p>
                        <label>
                            <input type="hidden" name="fields[{{ loop.index0 }}][required]" value="0">
                            <input type="checkbox" name="fields[{{ loop.index0 }}][required]" value="1" {% if field_required %}checked{% endif %}>
                            Required
                        </label>
                    </p>

                    <p>
                        <button type="submit" name="_remove_field[{{ loop.index0 }}]" value="1">Remove field</button>
                    </p>
                </fieldset>
            {% endfor %}

            <p>
                <button type="submit" name="_add_field" value="1">Add field</button>
            </p>
        </fieldset>

        <p>
            <button type="submit">Save collection</button>
            <a href="{{ cancel_url|e }}">Cancel</a>
        </p>
    </form>
</main>
{% endblock %}
