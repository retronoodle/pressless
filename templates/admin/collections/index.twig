{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Collections - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-collections{% endblock %}

{% block body %}
{% include 'admin/_header.twig' with {active_nav: 'collections'} %}

<main class="admin-main">
    <section class="collections-header">
        <h2>Collections</h2>
        {% if is_admin %}
            <p><a href="/admin/collections/new">{% include 'admin/_icons/add.twig' %}New collection</a></p>
        {% endif %}
    </section>

    {% if collections is empty %}
        {{ state.empty('No collections yet', 'Create your first collection to start defining content.', is_admin ? '/admin/collections/new' : null, is_admin ? 'Create collection' : null) }}
    {% else %}
        <table class="admin-table collections-table">
            <thead>
                <tr>
                    <th scope="col">Slug</th>
                    <th scope="col">Name</th>
                    <th scope="col">Fields</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for collection in collections %}
                    <tr>
                        <td><code>{{ collection.slug|e }}</code></td>
                        <td>{{ collection.name|e }}</td>
                        <td>{{ collection.field_count }}</td>
                        <td>
                            <a href="/admin/collections/{{ collection.slug|e }}">Entries</a>
                            &middot;
                            <a href="/admin/collections/{{ collection.slug|e }}/edit">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}
