{% extends 'layout/base.twig' %}

{% import 'admin/_state.twig' as state %}

{% block title %}Collections - Stead admin{% endblock %}

{% block body_class %}stead stead-admin stead-collections{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Stead admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin/collections" aria-current="page">Collections</a></li>
            <li><a href="/admin/media">Media</a></li>
            {% if user_role == 'admin' %}
                <li><a href="/admin/users">Users</a></li>
                <li><a href="/admin/permissions">Permissions</a></li>
            {% else %}
                <li><span class="nav-placeholder" aria-disabled="true">Users</span></li>
                <li><span class="nav-placeholder" aria-disabled="true">Settings</span></li>
            {% endif %}
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong>.</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="collections-header">
        <h2>Collections</h2>
        {% if is_admin %}
            <p><a href="/admin/collections/new">New collection</a></p>
        {% endif %}
    </section>

    {% if collections is empty %}
        {{ state.empty('No collections yet', 'Create your first collection to start defining content.', is_admin ? '/admin/collections/new' : null, is_admin ? 'Create collection' : null) }}
    {% else %}
        <table class="collections-table">
            <thead>
                <tr>
                    <th scope="col">Slug</th>
                    <th scope="col">Name</th>
                    <th scope="col">Fields</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for collection in collections %}
                    <tr>
                        <td><code>{{ collection.slug|e }}</code></td>
                        <td>{{ collection.name|e }}</td>
                        <td>{{ collection.field_count }}</td>
                        <td>
                            <a href="/admin/collections/{{ collection.slug|e }}">Entries</a>
                            &middot;
                            <a href="/admin/collections/{{ collection.slug|e }}/edit">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}
