{% extends 'layout.twig' %}

{% block title %}Sample data - Install Stead{% endblock %}

{% block content %}
<section class="installer-step-page">
    <h2>Load sample data?</h2>
    <p>Sample data creates a starter <em>posts</em> collection with three entries so you can see the content engine at work. You can remove the collection afterwards.</p>
    <p>Either choice finishes the installer and takes you to the admin login.</p>

    {% if error %}
        <p role="alert" class="installer-error">{{ error|e }}</p>
    {% endif %}

    <form method="post" action="/install/sample-data" class="installer-form">
        <fieldset class="installer-choice">
            <legend>Sample data</legend>
            <label>
                <input type="radio" name="choice" value="yes" {% if choice == 'yes' %}checked{% endif %}>
                <span>Yes, load sample content</span>
            </label>
            <label>
                <input type="radio" name="choice" value="no" {% if choice == 'no' %}checked{% endif %}>
                <span>No, start with an empty site</span>
            </label>
        </fieldset>
        <p class="installer-form-actions">
            <button type="submit">Continue</button>
        </p>
    </form>
</section>
{% endblock %}