{% extends 'layout/base.twig' %}

{% block title %}Pressless admin{% endblock %}

{% block body_class %}pressless pressless-admin{% endblock %}

{% block body %}
<header class="admin-header">
    <h1>Pressless admin</h1>
    <nav class="admin-nav" aria-label="Admin sections">
        <ul>
            <li><a href="/admin" aria-current="page">Dashboard</a></li>
            <li><span class="nav-placeholder" aria-disabled="true">Collections</span></li>
            <li><span class="nav-placeholder" aria-disabled="true">Media</span></li>
            <li><span class="nav-placeholder" aria-disabled="true">Users</span></li>
            <li><span class="nav-placeholder" aria-disabled="true">Settings</span></li>
        </ul>
    </nav>
    <div class="admin-account">
        <p>Signed in as <strong>{{ user_name }}</strong>.</p>
        <form method="post" action="/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</header>

<main class="admin-main">
    <section class="empty-state">
        <h2>No collections yet</h2>
        <p>Pressless is in Phase 1. Once you create a collection, entries and
            field values will live here. For now, this is intentionally empty so
            you can confirm the administrator shell is wired up correctly.</p>
    </section>
</main>
{% endblock %}